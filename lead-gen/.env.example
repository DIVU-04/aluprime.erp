# Get a key at: https://console.cloud.google.com/
# Enable APIs: "Places API (New)" and "Geocoding API"
# Restrict the key to your server IP for production.
GOOGLE_MAPS_API_KEY=your_google_cloud_api_key_here

# Server
PORT=3000

# Optional: turn website scraping (for emails/socials) on or off by default
# Users can also toggle it in the UI.
SCRAPE_WEBSITES=true
