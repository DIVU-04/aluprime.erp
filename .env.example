# LLM provider (OpenAI-compatible API)
NIRA_LLM_API_KEY=your-api-key-here
NIRA_LLM_BASE_URL=https://api.openai.com/v1
NIRA_LLM_MODEL=gpt-4o-mini

# Agent settings
NIRA_AGENT_NAME=Nira
NIRA_DATA_DIR=./data
NIRA_LOG_LEVEL=INFO
NIRA_FUTURISTIC_UI=true

# Voice (install: pip install -r requirements-voice.txt)
NIRA_VOICE_ENABLED=false
NIRA_VOICE_OUTPUT=true
NIRA_WAKE_WORD=nira
NIRA_LISTEN_TIMEOUT=8
NIRA_PHRASE_TIME_LIMIT=20
NIRA_TTS_RATE=175

# Optional: web search (DuckDuckGo works without a key)
# NIRA_WEB_SEARCH_ENABLED=true
