# ------------------------------------------------------------------
# Google Maps Lead Generator — configuration
# Copy this file to ".env" and fill in the values you need.
# ------------------------------------------------------------------

# Port the web server listens on.
PORT=3000

# --- Google Places API (recommended, richest data) ----------------
# Create a key in Google Cloud Console and enable the "Places API (New)".
# Docs: https://developers.google.com/maps/documentation/places/web-service/overview
# Leave blank to use the free OpenStreetMap provider instead.
GOOGLE_MAPS_API_KEY=

# Default data provider when the UI doesn't specify one.
#   google = Google Places API (needs GOOGLE_MAPS_API_KEY)
#   osm    = OpenStreetMap / Overpass (free, no key, less complete)
DEFAULT_PROVIDER=google
